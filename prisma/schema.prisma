generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  reviews   Review[]
  comments  Comment[]
}

// Game model
model Game {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  reviews     Review[]
}

// Review model
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // 1-5 stars
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  game      Game     @relation(fields: [gameId], references: [id])
  gameId    Int
  comments  Comment[]
}

// Comment model
model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  review    Review   @relation(fields: [reviewId], references: [id])
  reviewId  Int
}